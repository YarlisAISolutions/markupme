{
  "name": "markupme",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "test": "turbo run test && vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome ci .",
    "api:update": "UPDATE_API_SNAPSHOT=1 vitest run && biome format --write api/exports.snapshot.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@azure/msal-node": "7.1.2",
    "katex": "0.19.1"
  }
}
