{
  "name": "@markupme/core",
  "version": "0.1.0",
  "description": "MarkupMe core: standards-first Markdown (CommonMark + GFM) parsing, a typed document model, safe HTML rendering, Markdown serialization, linting and TOC on unified/remark.",
  "license": "MIT",
  "author": "Yarlis AI Solutions",
  "homepage": "https://github.com/YarlisAISolutions/markupme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarlisAISolutions/markupme.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/YarlisAISolutions/markupme/issues",
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "remark",
    "unified",
    "mdast",
    "html",
    "sanitize",
    "toc",
    "lint"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "hast-util-sanitize": "5.0.2",
    "mdast-util-directive": "3.1.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "smol-toml": "1.9.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
