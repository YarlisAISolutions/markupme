{
  "name": "markupme-vscode",
  "displayName": "MarkupMe",
  "description": "Markdown preview with Mermaid, Graphviz and Blueprint diagrams, syntax highlighting, lint diagnostics, a table of contents, formatting and HTML export. Safe by default.",
  "version": "0.2.0",
  "private": true,
  "publisher": "yarlis",
  "license": "MIT",
  "author": "Yarlis AI Solutions",
  "homepage": "https://github.com/YarlisAISolutions/markupme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarlisAISolutions/markupme.git",
    "directory": "packages/vscode"
  },
  "bugs": "https://github.com/YarlisAISolutions/markupme/issues",
  "icon": "icon.png",
  "keywords": [
    "markdown",
    "markdown preview",
    "preview",
    "mermaid",
    "graphviz",
    "diagrams",
    "table of contents",
    "toc",
    "markdown lint",
    "lint",
    "formatter",
    "github alerts",
    "html export",
    "katex",
    "math"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Visualization",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markupme.openPreview",
        "title": "Open Preview",
        "category": "MarkupMe",
        "icon": "$(open-preview)"
      },
      {
        "command": "markupme.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "MarkupMe",
        "icon": "$(open-preview)"
      },
      {
        "command": "markupme.exportHtml",
        "title": "Export to HTML",
        "category": "MarkupMe"
      },
      {
        "command": "markupme.insertToc",
        "title": "Insert/Update Table of Contents",
        "category": "MarkupMe"
      },
      {
        "command": "markupme.formatDocument",
        "title": "Format Document",
        "category": "MarkupMe"
      },
      {
        "command": "markupme.toggleBold",
        "title": "Toggle Bold",
        "category": "MarkupMe",
        "icon": "$(bold)"
      },
      {
        "command": "markupme.toggleItalic",
        "title": "Toggle Italic",
        "category": "MarkupMe",
        "icon": "$(italic)"
      },
      {
        "command": "markupme.toggleStrikethrough",
        "title": "Toggle Strikethrough",
        "category": "MarkupMe"
      },
      {
        "command": "markupme.toggleCode",
        "title": "Toggle Inline Code",
        "category": "MarkupMe",
        "icon": "$(code)"
      },
      {
        "command": "markupme.showWalkthrough",
        "title": "Get Started",
        "category": "MarkupMe"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markupme.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markupme.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.openPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.exportHtml",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.insertToc",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.formatDocument",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.toggleBold",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.toggleItalic",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.toggleStrikethrough",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markupme.toggleCode",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/context": [
        {
          "command": "markupme.openPreviewToSide",
          "when": "editorLangId == markdown",
          "group": "markupme@1"
        },
        {
          "command": "markupme.insertToc",
          "when": "editorLangId == markdown && !editorReadonly",
          "group": "markupme@2"
        },
        {
          "command": "markupme.exportHtml",
          "when": "editorLangId == markdown",
          "group": "markupme@3"
        }
      ],
      "explorer/context": [
        {
          "command": "markupme.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "MarkupMe",
      "properties": {
        "markupme.preview.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme.",
            "Always light.",
            "Always dark."
          ],
          "default": "auto",
          "description": "Color theme of the MarkupMe preview and of exported HTML."
        },
        "markupme.preview.sanitize": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Sanitize the rendered HTML (GitHub's schema). **Warning:** turning this off lets raw HTML in a document through unchanged. Turn it off only for documents you trust."
        },
        "markupme.preview.lineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Show line numbers on every code block."
        },
        "markupme.markdown.math": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Render `$inline$` and `$$block$$` math with KaTeX."
        },
        "markupme.markdown.emoji": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Turn `:shortcode:` emoji into emoji characters."
        },
        "markupme.diagrams.providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blueprint",
              "graphviz",
              "mermaid"
            ]
          },
          "default": [
            "blueprint",
            "graphviz",
            "mermaid"
          ],
          "description": "Diagram renderers to use. Blueprint and Graphviz render in VS Code; Mermaid renders in the preview."
        },
        "markupme.diagrams.server": {
          "type": "string",
          "default": "",
          "markdownDescription": "Kroki server URL (for example `https://kroki.io` or a self-hosted `http://localhost:8000`) for PlantUML, C4, Structurizr, D2 and more. **This sends the diagram source to that server.** Empty turns Kroki off."
        },
        "markupme.toc.minDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 2,
          "description": "Shallowest heading level in a generated table of contents."
        },
        "markupme.toc.maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 3,
          "description": "Deepest heading level in a generated table of contents."
        },
        "markupme.format.enable": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Register MarkupMe as a formatter for Markdown (**Format Document**). Off by default so it does not replace your formatter. The `MarkupMe: Format Document` command works either way."
        },
        "markupme.validate.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show MarkupMe lint diagnostics in the Problems panel."
        },
        "markupme.validate.rules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "info",
              "warning",
              "error"
            ]
          },
          "markdownDescription": "Override rule severities by rule name or code, for example `{ \"single-h1\": \"off\", \"MM005\": \"error\" }`."
        },
        "markupme.editor.shortcuts": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use **Ctrl/Cmd+B**, **Ctrl/Cmd+I** and **Alt+S** in Markdown files for bold, italic and strikethrough. Off by default because these keys already toggle the sidebar and open inline chat in VS Code and Cursor."
        },
        "markupme.notifications.whatsNew": {
          "type": "boolean",
          "default": true,
          "description": "After an update that adds features, show a short notice with a link to the release notes."
        }
      }
    },
    "keybindings": [
      {
        "command": "markupme.openPreviewToSide",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markupme.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && config.markupme.editor.shortcuts"
      },
      {
        "command": "markupme.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && config.markupme.editor.shortcuts"
      },
      {
        "command": "markupme.toggleStrikethrough",
        "key": "alt+s",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && config.markupme.editor.shortcuts"
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "markupme.config.json",
        "url": "./schemas/markupme.config.schema.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "markupme.gettingStarted",
        "title": "Get started with MarkupMe",
        "description": "Preview, diagrams, problems, a table of contents, export and shortcuts in seven short steps.",
        "when": "true",
        "steps": [
          {
            "id": "preview",
            "title": "Open the live preview",
            "description": "Open any Markdown file and select **Open Preview to the Side** in the editor title bar, or press **Ctrl+Alt+M** (**Cmd+Alt+M** on macOS). The preview follows the editor as you type and scroll.\n[Open Preview](command:markupme.openPreviewToSide)",
            "media": {
              "markdown": "walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:markupme.openPreviewToSide"
            ]
          },
          {
            "id": "diagrams",
            "title": "Draw diagrams as code",
            "description": "Type `mermaid`, `dot` or `ybp` and pick the snippet. Mermaid, Graphviz and Yarlis Blueprint diagrams render in the preview, with no CDN and no account.",
            "media": {
              "markdown": "walkthrough/diagrams.md"
            },
            "completionEvents": [
              "onCommand:markupme.openPreview"
            ]
          },
          {
            "id": "problems",
            "title": "Fix problems as you write",
            "description": "Broken links, skipped heading levels, missing alt text and more show in the Problems panel with a rule code. Tune them with `markupme.validate.rules`.\n[Show Problems](command:workbench.actions.view.problems)",
            "media": {
              "markdown": "walkthrough/problems.md"
            },
            "completionEvents": [
              "onCommand:workbench.actions.view.problems"
            ]
          },
          {
            "id": "toc",
            "title": "Add a table of contents",
            "description": "Run **MarkupMe: Insert/Update Table of Contents**. Run it again after editing headings; only the TOC region changes.\n[Insert Table of Contents](command:markupme.insertToc)",
            "media": {
              "markdown": "walkthrough/toc.md"
            },
            "completionEvents": [
              "onCommand:markupme.insertToc"
            ]
          },
          {
            "id": "export",
            "title": "Share it as a web page",
            "description": "**MarkupMe: Export to HTML** writes a standalone page with diagrams and highlighting, ready to send or host.\n[Export to HTML](command:markupme.exportHtml)",
            "media": {
              "markdown": "walkthrough/export.md"
            },
            "completionEvents": [
              "onCommand:markupme.exportHtml"
            ]
          },
          {
            "id": "shortcuts",
            "title": "Format with the keyboard",
            "description": "Turn on **Ctrl/Cmd+B**, **Ctrl/Cmd+I** and **Alt+S** for bold, italic and strikethrough in Markdown files. They are off by default because VS Code and Cursor already use some of these keys.\n[Turn on shortcuts](command:workbench.action.openSettings?%5B%22markupme.editor.shortcuts%22%5D)",
            "media": {
              "markdown": "walkthrough/shortcuts.md"
            },
            "completionEvents": [
              "onSettingChanged:markupme.editor.shortcuts"
            ]
          },
          {
            "id": "settings",
            "title": "Make it yours",
            "description": "Pick the preview theme, turn on math or emoji, choose diagram renderers, or let MarkupMe format on save.\n[Open MarkupMe settings](command:workbench.action.openSettings?%5B%22markupme%22%5D)",
            "media": {
              "markdown": "walkthrough/settings.md"
            },
            "completionEvents": [
              "onSettingChanged:markupme"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "icon": "node scripts/icon.mjs",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/YarlisAISolutions/markupme/blob/HEAD/packages/vscode --baseImagesUrl https://github.com/YarlisAISolutions/markupme/raw/HEAD/packages/vscode",
    "vscode:prepublish": "bun run build",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@markupme/core": "0.1.0",
    "@markupme/diagrams": "0.1.0",
    "@markupme/highlight": "0.1.0",
    "@markupme/themes": "0.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/mdast": "4.0.4",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "katex": "0.16.47",
    "mermaid": "12.2.0",
    "ovsx": "1.3.0"
  },
  "galleryBanner": {
    "color": "#1F5A9E",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace, rendering stays sanitized and Kroki stays off, whatever the workspace settings say.",
      "restrictedConfigurations": [
        "markupme.preview.sanitize",
        "markupme.diagrams.server"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "In virtual workspaces, the check for missing local files (MM012) is skipped."
    }
  }
}
